# Nome público da instância e URL raiz usada para links enviados por e-mail.
APP_NAME="Rinos One"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
AUTHORIZATION_AUDIT_RETENTION_DAYS=90
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Cadeia de CAs PEM usada na conexão TLS com a fonte oficial do BCB. Mantenha
# a validação TLS ativa; informe um bundle confiável somente quando o PHP não
# herdar a confiança de certificados do sistema operacional.
BCB_CA_BUNDLE=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexão global da aplicação. Nunca versione credenciais reais.
DB_CONNECTION=core
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rinosone
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Schema global e convenção para schemas de tenant.
RINOS_CORE_DATABASE=rinosone
RINOS_TENANT_DATABASE_PREFIX=rinosone_

# Credencial exclusiva para migrations do schema global. Não reutilize a conta de runtime.
CORE_MIGRATION_HOST=127.0.0.1
CORE_MIGRATION_PORT=3306
CORE_MIGRATION_DATABASE=rinosone
CORE_MIGRATION_USERNAME=change-me
CORE_MIGRATION_PASSWORD=change-me
CORE_MIGRATION_SOCKET=

# Credencial normal usada apenas ao abrir um schema de tenant já validado.
# O schema é derivado internamente do identificador BIGINT e nunca é informado neste arquivo.
TENANT_RUNTIME_HOST=127.0.0.1
TENANT_RUNTIME_PORT=3306
TENANT_RUNTIME_USERNAME=change-me
TENANT_RUNTIME_PASSWORD=change-me
TENANT_RUNTIME_SOCKET=

# Credencial exclusiva do worker de provisionamento. Não reutilize a credencial de runtime.
# TENANT_PROVISIONING_DATABASE pode ficar vazio: o worker cria e seleciona schemas conforme necessário.
TENANT_PROVISIONING_HOST=127.0.0.1
TENANT_PROVISIONING_PORT=3306
TENANT_PROVISIONING_DATABASE=
TENANT_PROVISIONING_USERNAME=change-me
TENANT_PROVISIONING_PASSWORD=change-me
TENANT_PROVISIONING_SOCKET=

# Política do worker de provisionamento. A classificação de falhas é interna e não expõe infraestrutura.
TENANT_PROVISIONING_MAXIMUM_ATTEMPTS=3
TENANT_PROVISIONING_RETRY_DELAYS_MINUTES=1,5,15

SESSION_DRIVER=rinos-database
# Zero desativa expiração por inatividade; altere somente se a instância exigir prazo técnico.
SESSION_LIFETIME=0
SESSION_EXPIRE_ON_CLOSE=true
SESSION_TABLE=session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção, use HTTPS e defina este valor como true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Armazenamento privado da fundação de arquivos. O caminho não é publicado por link simbólico.
FILE_STORAGE_DEFAULT_BACKEND=local-private
FILE_STORAGE_LOCAL_PRIVATE_DISK=file-private
FILE_STORAGE_LOCAL_PRIVATE_PATH=
FILE_STORAGE_LOCAL_PRIVATE_STATE=ACTIVE
# Novos pontos de montagem podem ser declarados em JSON, por exemplo:
# {"archive-1":{"disk":"archive-private","state":"ACTIVE"}}
FILE_STORAGE_BACKEND_DEFINITIONS={}
# Arquivos na lixeira continuam consumindo quota até a limpeza ou expiração.
FILE_TRASH_RETENTION_DAYS=30
# A retenção técnica nunca pode ser menor que a retenção de backup da instância.
FILE_BACKUP_RETENTION_DAYS=60
FILE_TECHNICAL_RETENTION_DAYS=60
FILE_ORPHAN_RETENTION_DAYS=60
# Regras JSON de compactação. Cada regra pode filtrar por mimeTypes e/ou extensions.
# O sistema promove GZIP apenas quando o resultado for menor que os bytes lógicos.
FILE_COMPRESSION_RULES=[{"mimeTypes":["text/*","application/json","application/xml"],"extensions":["txt","csv","json","xml","log"],"encoding":"GZIP"}]
# Intervalo do reprocessamento de compactação, em minutos (1 a 60).
FILE_COMPRESSION_REPROCESS_INTERVAL_MINUTES=60
# Intervalo, em minutos, para expurgar posses, versões e objetos privados elegíveis.
# Valores entre 1 e 59 permitem execução mais de uma vez por hora; 60 executa no início de cada hora.
FILE_STORAGE_RETENTION_PURGE_INTERVAL_MINUTES=60
# Intervalo, em minutos, para verificar referências quebradas e objetos privados órfãos.
FILE_STORAGE_RECONCILIATION_INTERVAL_MINUTES=60
# Canal técnico de arquivos: não registrar conteúdo, nome, hash, caminho ou credenciais.
FILE_STORAGE_LOG_LEVEL=warning
FILE_STORAGE_LOG_RETENTION_DAYS=30
# Política de imagem de perfil. O servidor processa somente estes MIME types e descarta a origem após gerar o recorte final.
PROFILE_AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# 10 MiB; limite do arquivo de origem enviado ao editor.
PROFILE_AVATAR_MAXIMUM_SIZE_BYTES=10485760
# Não é realizado upscale: ambas as dimensões da origem devem atender a este mínimo.
PROFILE_AVATAR_MINIMUM_DIMENSION_PIXELS=400
# Lado do recorte quadrado privado produzido pelo servidor.
PROFILE_AVATAR_OUTPUT_DIMENSION_PIXELS=400
QUEUE_CONNECTION=database
# Mantém o e-mail fora da fila até que o cadastro e sua emissão sejam confirmados no banco.
DB_QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transporte SMTP da instância. O canal `log` é seguro para inspeção local; altere para `smtp` somente no ambiente com provedor configurado.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_TIMEOUT=5
MAIL_EHLO_DOMAIN=localhost
# Capturador SMTP exclusivo para testes automatizados; deixe vazio fora desse ambiente.
MAILPIT_API_URL=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Política da autenticação de acesso. Zero significa sem expiração por inatividade ou duração.
ACCESS_EMAIL_CHALLENGE_LIFETIME_MINUTES=10
ACCESS_EMAIL_EMISSION_LIMIT=3
ACCESS_EMAIL_EMISSION_WINDOW_MINUTES=15
# Intervalo mínimo entre emissões para o mesmo endereço; protege o envio mesmo após recarregar a página.
ACCESS_EMAIL_RESEND_COOLDOWN_SECONDS=180
ACCESS_ORIGIN_EMISSION_LIMIT=10
ACCESS_ORIGIN_EMISSION_WINDOW_MINUTES=60
ACCESS_USER_EMISSION_LIMIT=3
ACCESS_USER_EMISSION_WINDOW_MINUTES=15
ACCESS_CODE_ATTEMPT_LIMIT=5
ACCESS_CODE_ATTEMPT_WINDOW_MINUTES=10
# Número máximo de códigos incorretos por emissão; ao atingir o limite, a emissão é excluída.
ACCESS_CODE_MAXIMUM_ATTEMPTS=3
ACCESS_PASSWORD_ATTEMPT_LIMIT=5
ACCESS_PASSWORD_ATTEMPT_WINDOW_MINUTES=15
ACCESS_USER_PASSWORD_ATTEMPT_LIMIT=5
ACCESS_USER_PASSWORD_ATTEMPT_WINDOW_MINUTES=15
ACCESS_TEMPORARY_BLOCK_MINUTES=15
ACCESS_SESSION_INACTIVITY_TIMEOUT_MINUTES=0
ACCESS_PERSISTENT_LOGIN_LIFETIME_DAYS=0
ACCESS_PERSISTENT_COOKIE_NAME=rinosone-persistent-authentication
ACCESS_SECURITY_LOG_RETENTION_DAYS=30
ACCESS_SECURITY_LOG_LEVEL=info
# Intervalo do scheduler, em minutos, entre 1 e 59.
ACCESS_EXPIRED_CHALLENGE_CLEANUP_INTERVAL_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
