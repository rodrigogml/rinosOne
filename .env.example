# Nome público da instância e URL raiz usada para links enviados por e-mail.
APP_NAME="Rinos One"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexão com o schema principal. Nunca versione credenciais reais.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rinosone
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Convenção reservada para schemas de tenants futuros; não cria tenants.
RINOS_CORE_DATABASE=rinosone
RINOS_TENANT_DATABASE_PREFIX=rinosone_

SESSION_DRIVER=rinos-database
# Zero desativa expiração por inatividade; altere somente se a instância exigir prazo técnico.
SESSION_LIFETIME=0
SESSION_EXPIRE_ON_CLOSE=true
SESSION_TABLE=session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção, use HTTPS e defina este valor como true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Mantém o e-mail fora da fila até que o cadastro e sua emissão sejam confirmados no banco.
DB_QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transporte SMTP da instância. O canal `log` é seguro para inspeção local; altere para `smtp` somente no ambiente com provedor configurado.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_TIMEOUT=5
MAIL_EHLO_DOMAIN=localhost
# Capturador SMTP exclusivo para testes automatizados; deixe vazio fora desse ambiente.
MAILPIT_API_URL=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Política da autenticação de acesso. Zero significa sem expiração por inatividade ou duração.
ACCESS_EMAIL_CHALLENGE_LIFETIME_MINUTES=10
ACCESS_EMAIL_EMISSION_LIMIT=3
ACCESS_EMAIL_EMISSION_WINDOW_MINUTES=15
ACCESS_ORIGIN_EMISSION_LIMIT=10
ACCESS_ORIGIN_EMISSION_WINDOW_MINUTES=60
ACCESS_USER_EMISSION_LIMIT=3
ACCESS_USER_EMISSION_WINDOW_MINUTES=15
ACCESS_CODE_ATTEMPT_LIMIT=5
ACCESS_CODE_ATTEMPT_WINDOW_MINUTES=10
# Número máximo de códigos incorretos por emissão; ao atingir o limite, a emissão é excluída.
ACCESS_CODE_MAXIMUM_ATTEMPTS=3
ACCESS_PASSWORD_ATTEMPT_LIMIT=5
ACCESS_PASSWORD_ATTEMPT_WINDOW_MINUTES=15
ACCESS_USER_PASSWORD_ATTEMPT_LIMIT=5
ACCESS_USER_PASSWORD_ATTEMPT_WINDOW_MINUTES=15
ACCESS_TEMPORARY_BLOCK_MINUTES=15
ACCESS_SESSION_INACTIVITY_TIMEOUT_MINUTES=0
ACCESS_PERSISTENT_LOGIN_LIFETIME_DAYS=0
ACCESS_PERSISTENT_COOKIE_NAME=rinosone-persistent-authentication
ACCESS_SECURITY_LOG_RETENTION_DAYS=30
ACCESS_SECURITY_LOG_LEVEL=info
# Intervalo do scheduler, em minutos, entre 1 e 59.
ACCESS_EXPIRED_CHALLENGE_CLEANUP_INTERVAL_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
